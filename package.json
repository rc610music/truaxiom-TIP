{
  "name": "truaxiom-tip",
  "version": "0.0.1",
  "private": true,
  "description": "TruaXiom Intelligence Platform — business intelligence operating system and Mission Control workspace.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @truaxiom/mission-control",
    "dev:api": "npm run dev --workspace @truaxiom/api",
    "dev:full": "echo Run API and Mission Control in separate terminals: npm run dev:api && npm run dev",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @truaxiom/api",
    "build:mission-control": "npm run build --workspace @truaxiom/mission-control",
    "build:mission-control-preview": "npm run build:preview --workspace @truaxiom/mission-control",
    "start:api": "npm run start --workspace @truaxiom/api",
    "wait:api": "node scripts/wait-for-api.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:structure": "node scripts/check-repo-structure.mjs",
    "check:contracts": "node scripts/check-foundation-contracts.mjs",
    "check:foundation": "npm run check:structure && npm run check:contracts && npm run build:mission-control-preview",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:api": "node scripts/test-api-loop.mjs",
    "ci": "npm run check:foundation",
    "ci:legacy-api": "npm run check:structure && npm run typecheck && npm run build:api"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
