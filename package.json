{
  "name": "truaxiom-tip",
  "version": "0.0.1",
  "private": true,
  "description": "TruaXiom Intelligence Platform — business intelligence operating system and Mission Control workspace.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @truaxiom/mission-control",
    "dev:api": "npm run dev --workspace @truaxiom/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @truaxiom/api",
    "start:api": "npm run start --workspace @truaxiom/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:structure": "node scripts/check-repo-structure.mjs",
    "ci": "npm run check:structure && npm run typecheck && npm run build:api"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
