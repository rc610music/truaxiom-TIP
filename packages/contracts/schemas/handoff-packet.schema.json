{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/handoff-packet/v1",
  "title": "TIP handoff-packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "mission_id",
    "delegation_id",
    "project_id",
    "revision",
    "assigned_agent_id",
    "state",
    "blockers",
    "evidence",
    "handoffs",
    "review_required",
    "completion_result",
    "updated_at",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "const": "TIP"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "delegation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "assigned_agent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "UNROUTABLE",
        "NEEDS_APPROVAL",
        "ASSIGNED",
        "RUNNING",
        "BLOCKED",
        "REVIEW",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.truaxiom.llc/tip/artifact/v1"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.truaxiom.llc/tip/handoff-request/v1"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "review_required": {
      "type": "boolean"
    },
    "completion_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.truaxiom.llc/tip/failure-event/v1"
      },
      "maxItems": 100
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "required_capabilities",
        "required_permissions",
        "routing",
        "latest_event",
        "approval_status",
        "verification_status",
        "independent_verification",
        "next_action"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routing": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selected_agent",
                "selection_reason",
                "candidates",
                "fallback_candidates"
              ],
              "properties": {
                "selected_agent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "selection_reason": {
                  "type": "string"
                },
                "fallback_candidates": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "agent_id",
                      "eligible",
                      "reasons",
                      "capability_status"
                    ],
                    "properties": {
                      "agent_id": {
                        "type": "string"
                      },
                      "eligible": {
                        "type": "boolean"
                      },
                      "reasons": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "capability_status": {
                        "const": "DECLARED"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "latest_event": {
          "$ref": "https://schemas.truaxiom.llc/tip/state-event/v1"
        },
        "approval_status": {
          "enum": [
            "PENDING",
            "OPERATOR_APPROVED",
            "REJECTED",
            "NOT_REQUIRED"
          ]
        },
        "verification_status": {
          "enum": [
            "UNVERIFIED",
            "CLAIMED",
            "HASH_VERIFIED"
          ]
        },
        "independent_verification": {
          "const": "NOT_RECORDED"
        },
        "next_action": {
          "type": "string"
        }
      }
    }
  }
}
