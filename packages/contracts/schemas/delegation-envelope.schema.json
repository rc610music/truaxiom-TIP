{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.truaxiom.llc/tip/delegation-envelope/v1",
  "title":"TIP Delegation Envelope",
  "type":"object",
  "additionalProperties":false,
  "required":["delegation_id","mission_id","requested_capability","assigned_agent_id","requested_by","status","created_at","constraints","evidence_required"],
  "properties":{
    "delegation_id":{"type":"string","minLength":1},
    "mission_id":{"type":"string","minLength":1},
    "requested_capability":{"type":"string","minLength":1},
    "assigned_agent_id":{"type":"string","minLength":1},
    "requested_by":{"type":"string","minLength":1},
    "status":{"type":"string","enum":["queued","assigned","running","blocked","review","completed","failed","cancelled"]},
    "created_at":{"type":"string","format":"date-time"},
    "constraints":{"type":"array","items":{"type":"string"}},
    "evidence_required":{"type":"array","items":{"type":"string"}}
  }
}