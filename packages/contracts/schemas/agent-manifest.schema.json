{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/agent-manifest/v1",
  "title": "TIP Agent Manifest",
  "description": "Canonical governed contract for a role-specific TIP worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id", "name", "version", "owner", "role", "description", "objectives", "scope", "exclusions",
    "lifecycle_state", "capabilities", "tools", "data_sources", "memory_policy", "permissions", "approval_policy",
    "triggers", "workflows", "output_contracts", "escalation_policy", "observability_policy", "dependency_versions", "tags"
  ],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "lifecycle_state": { "type": "string", "enum": ["draft", "validating", "active", "paused", "deprecated", "retired"] },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "data_sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "memory_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_scopes", "retention"],
      "properties": {
        "allowed_scopes": { "type": "array", "items": { "type": "string", "enum": ["user", "project", "agent_working", "run", "organization"] }, "uniqueItems": true },
        "retention": { "type": "string", "minLength": 1 }
      }
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "approval_policy": {
      "type": "object",
      "required": ["default_tier", "approval_required_for"],
      "properties": {
        "default_tier": { "type": "string", "enum": ["observe", "recommend", "draft", "execute_with_approval", "execute"] },
        "approval_required_for": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "triggers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "workflows": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "output_contracts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "escalation_policy": { "type": "string", "minLength": 1 },
    "observability_policy": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "dependency_versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "actions"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "write": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
