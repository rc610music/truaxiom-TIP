{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/workflow-definition/v1",
  "title": "TIP Workflow Definition",
  "description": "Versioned orchestration contract. A workflow coordinates work but does not grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "name", "version", "owner", "lifecycle_state", "entry_step_id", "steps", "failure_policy", "audit_policy"],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "lifecycle_state": { "type": "string", "enum": ["draft", "validating", "active", "paused", "deprecated", "retired"] },
    "entry_step_id": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "name", "type", "actor_identity_id", "next_step_ids", "requires_approval"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["action", "parallel", "condition", "approval", "human_task", "agent_handoff", "tool_action", "validation", "compensation"]
          },
          "actor_identity_id": { "type": "string", "minLength": 1 },
          "input_contract": { "type": "string" },
          "output_contract": { "type": "string" },
          "next_step_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "requires_approval": { "type": "boolean" },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "retry_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_attempts", "backoff"],
            "properties": {
              "max_attempts": { "type": "integer", "minimum": 1 },
              "backoff": { "type": "string", "enum": ["none", "fixed", "exponential"] }
            }
          },
          "condition": { "type": "string" },
          "compensation_step_id": { "type": "string" }
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_uncertainty", "on_permission_denied", "on_repeated_failure"],
      "properties": {
        "on_uncertainty": { "type": "string", "enum": ["stop", "escalate"] },
        "on_permission_denied": { "type": "string", "const": "stop" },
        "on_repeated_failure": { "type": "string", "enum": ["stop", "escalate", "compensate"] }
      }
    },
    "audit_policy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
