{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/identity/v1",
  "title": "TIP Identity Manifest",
  "description": "Provider-neutral identity and capability contract for an object registered with TIP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_id",
    "kind",
    "name",
    "version",
    "owner_identity_id",
    "lifecycle_state",
    "capabilities",
    "dependencies",
    "permissions",
    "authoritative_sources"
  ],
  "properties": {
    "identity_id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["organization", "product", "project", "service", "integration", "agent", "workflow", "tool", "source"]
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "owner_identity_id": { "type": "string", "minLength": 1 },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "validating", "active", "paused", "deprecated", "retired"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity_id", "version_constraint"],
        "properties": {
          "identity_id": { "type": "string", "minLength": 1 },
          "version_constraint": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "actions"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "write": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "authoritative_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "uri", "authority"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "enum": ["canonical", "approved", "reference"] }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uri", "protocol"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string", "enum": ["https", "webhook", "mcp", "queue", "internal"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "metadata": { "type": "object" }
  }
}
