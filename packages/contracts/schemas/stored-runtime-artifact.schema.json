{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/stored-runtime-artifact/v1",
  "title": "TIP stored runtime artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "kind", "content"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "content": { "type": "object" }
  }
}
