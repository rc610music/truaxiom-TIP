{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/delegation-envelope/v2",
  "title": "TIP delegation-envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "delegation_id",
    "requested_capability",
    "assigned_agent_id",
    "requested_by",
    "status",
    "created_at",
    "constraints",
    "evidence_required",
    "required_permissions",
    "risk_tier",
    "policy_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "delegation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "requested_capability": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "assigned_agent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "UNROUTABLE",
        "NEEDS_APPROVAL",
        "ASSIGNED",
        "RUNNING",
        "BLOCKED",
        "REVIEW",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "policy_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
