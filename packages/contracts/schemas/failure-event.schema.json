{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truaxiom.llc/tip/failure-event/v1",
  "title": "TIP failure-event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "delegation_id",
    "failure_id",
    "code",
    "message",
    "retryable",
    "recorded_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "delegation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "failure_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "retryable": {
      "type": "boolean"
    },
    "recorded_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
