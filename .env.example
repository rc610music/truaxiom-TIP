# TIP local environment template
# Copy to .env.local when running locally. Never commit real secrets.

# Application
TIP_ENV=local
TIP_DEFAULT_ORG_ID=ORG-TRUAXIOM
TIP_DEFAULT_PRODUCT_ID=PROD-TIP
TIP_FIRST_VALIDATION_PRODUCT_ID=PROD-ROOTWORK
TIP_ROOTWORK_URL=https://restoreyour.life

# API server
TIP_API_MODE=local-static
TIP_API_HOST=0.0.0.0
TIP_API_PORT=4310
TIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase placeholder values
# These remain blank until a Supabase project is created/connected.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Crawler controls
TIP_CRAWLER_MODE=mock
TIP_ENABLE_LIVE_CRAWLER=false
TIP_CRAWLER_MAX_DEPTH=2
TIP_CRAWLER_MAX_RECORDS=25
TIP_CRAWLER_DEFAULT_FREQUENCY=manual
TIP_CRAWLER_ALLOWED_HOSTS=restoreyour.life

# AI provider routing placeholder
# TIP should remain model/provider-agnostic.
TIP_AI_PROVIDER=manual
OPENAI_API_KEY=
